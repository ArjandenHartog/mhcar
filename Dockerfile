# Built by Infaris Cloud (Guard Hosting) on every push; generated by infaris-guard hosting up.
FROM node:22-alpine
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
RUN npm run build
RUN rm -rf .next/cache && ln -s /tmp/next-cache .next/cache
ENV NODE_ENV=production HOST=0.0.0.0 HOSTNAME=0.0.0.0 PORT=8080 NITRO_PORT=8080
USER node
EXPOSE 8080
CMD ["sh", "-c", "mkdir -p /tmp/next-cache && exec node node_modules/next/dist/bin/next start -H 0.0.0.0 -p 8080"]
